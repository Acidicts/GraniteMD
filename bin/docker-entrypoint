#!/bin/sh
set -e

# Pass through non-server commands (e.g. `rails db:prepare`, `rails runner`)
if [ "$1" != "./bin/rails" ] || [ "$2" != "server" ]; then
  exec "$@"
fi

# Remove any pid file left behind by a previous container
rm -f tmp/pids/server.pid

if [ "${SKIP_DB_PREPARE:-0}" != "1" ]; then
  bundle exec rails db:prepare
fi

exec "$@"
