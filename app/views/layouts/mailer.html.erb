<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; line-height: 1.5; color: #1f2328; }
      .mailer-container { max-width: 560px; margin: 0 auto; padding: 24px; }
      .mailer-footer { margin-top: 32px; font-size: 12px; color: #6a737d; }
    </style>
  </head>
  <body>
    <div class="mailer-container">
      <%= yield %>
      <div class="mailer-footer">
        Sent by GraniteMD &middot; <%= Granitemd.app_host %>
      </div>
    </div>
  </body>
</html>
