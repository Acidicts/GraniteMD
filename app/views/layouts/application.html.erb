<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "GraniteMD" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="GraniteMD">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <%= stylesheet_link_tag "layouts/application", "layouts/shared", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/buttons", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <nav class="nav">
      <%= link_to "Workspaces", dashboard_path, class: "btn-nav" %>
      <%= link_to "Settings", dashboard_path, class: "btn-nav" %>
      <div data-controller="layouts--profile-pill" data-action="click->layouts--profile-pill#clicked click@window->layouts--profile-pill#close">
        <%= render "shared/profile_pill" %>
        <div class="profile-pill-links hidden" data-layouts--profile-pill-target="links">
          <%= link_to "My Profile", dashboard_users_path, class: "btn btn-tertiary" %>
          <%= link_to "Logout", logout_path, class: "btn btn-tertiary", data: { turbo_method: :delete } %>
        </div>
      </div>
    </nav>
    <div class="content">
      <%= yield %>
    </div>
  </body>
</html>
