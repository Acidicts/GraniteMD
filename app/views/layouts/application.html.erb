<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "GraniteMD" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="GraniteMD">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    
    <%= stylesheet_link_tag "layouts/application", "layouts/shared", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "components/buttons", "components/alerts", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <%= flash_alerts %>
    <div class="app-shell" data-controller="layouts--hide-application">
      <div class="nav-rail">
        <div class="nav-clip">
          <nav class="nav" data-layouts--hide-application-target="nav" aria-label="Primary">
            <div class="nav-logo">
              <%= logo_svg(width: 32, height: 32) %> Granite <span class="granite-highlighted">MD</span>
            </div>
            <%= link_to "Workspaces", dashboard_workspaces_path, class: "btn-nav" %>
            <%= link_to "Settings", dashboard_path, class: "btn-nav" %>
            <div data-controller="layouts--profile-pill" data-action="click->layouts--profile-pill#clicked click@window->layouts--profile-pill#close">
              <%= render "shared/profile_pill" %>
              <div class="profile-pill-links hidden" data-layouts--profile-pill-target="links">
                <%= link_to "My Profile", dashboard_users_path, class: "btn btn-tertiary" %>
                <%= link_to "Logout", logout_path, class: "btn btn-tertiary", data: { turbo_method: :delete } %>
              </div>
            </div>
          </nav>
        </div>
        <button type="button"
                class="nav-toggle"
                data-action="click->layouts--hide-application#toggle"
                data-layouts--hide-application-target="toggle"
                aria-label="Hide navigation"
                aria-expanded="true"
                title="Hide navigation">
          <svg data-layouts--hide-application-target="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="10 3 5 8 10 13"></polyline>
          </svg>
        </button>
      </div>
      <div class="content">
        <%= yield %>
      </div>
    </div>
  </body>
</html>
