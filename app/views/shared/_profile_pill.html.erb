<div class="profile-pill">
    <% if current_user && current_user.pfp_image&.attached? %>
        <div class="pfp-image">
            <%= current_user.pfp_image %>
        </div>
        <span class="animated-underline"><%= current_user&.username || current_user&.first_name || "User" %></span>
    <% elsif current_user %>
        <%= profile_svg(width: 32, height: 32,  color: "var(--accent)", background: "#00000000") %>
        <span class="profile-pill-name animated-underline"><%= (current_user&.username || current_user&.first_name).blank? ? "User" : (current_user&.username || current_user&.first_name) %></span>
    <% else %>
        <%= link_to "Login", login_path, class: "btn-login" %>
    <% end %>
</div>