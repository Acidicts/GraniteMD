<% content_for :title, "Workspaces" %>
<% content_for :head do %>
  <%= stylesheet_link_tag "pages/dashboard/workspaces/workspace", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "pages/dashboard/workspaces/index", "data-turbo-track": "reload" %>
<% end %>

<div class="workspaces">
  <div class="workspaces__header">
    <div>
      <h1 class="workspaces__title">Your Workspaces</h1>
      <p class="workspaces__count"><%= pluralize(@workspaces.count, "workspace") %></p>
    </div>
    <%= link_to "New Workspace", new_dashboard_workspace_path, class: "btn btn-primary" %>
  </div>

  <% if @workspaces.any? %>
    <div class="workspaces-grid" id="workspaces">
      <% @workspaces.each do |workspace| %>
        <%= render workspace %>
      <% end %>
    </div>
  <% else %>
    <div class="workspaces__empty">
      <p class="workspaces__empty-title">No workspaces yet</p>
      <p class="workspaces__empty-text">Create your first workspace to start writing.</p>
      <%= link_to "Create Workspace", new_dashboard_workspace_path, class: "btn btn-primary" %>
    </div>
    <div class="workspaces-grid" id="workspaces">
    </div>
  <% end %>
</div>
