<article class="dashboard_workspace" id="<%= dom_id workspace %>">
  <%= link_to dashboard_workspace_path(workspace), class: "dashboard_workspace__media-link", tabindex: "-1", aria: { hidden: true } do %>
    <% if workspace.workspace_image.attached? %>
      <% if workspace.workspace_image.variable? %>
        <%= image_tag workspace.workspace_image.variant(:thumb), class: "dashboard_workspace__image", alt: "" %>
      <% else %>
        <%= image_tag workspace.workspace_image, class: "dashboard_workspace__image", alt: "" %>
      <% end %>
    <% else %>
      <%= render "shared/placeholders/workspace_image", text: "Workspace Banner Image", width: "200px", height: "133px" %>
    <% end %>

    <div class="dashboard_workspace__content_name">
      <p class="dashboard_workspace__name-link">
          <%= workspace.name %>
      </p>
    </div>
  <% end %>
</article>