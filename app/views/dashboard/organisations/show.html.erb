<% content_for :title, @organisation.name %>
<% content_for :head do %>
  <%= stylesheet_link_tag "pages/dashboard/organisations/show", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "animations/text", "data-turbo-track": "reload" %>

  <%= stylesheet_link_tag "pages/dashboard/workspaces/workspace", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "pages/dashboard/workspaces/index", "data-turbo-track": "reload" %>
<% end %>

<div class="organisation">
  <div class="organisation__header">
    <div class="organisation__header-image">
      <% if @organisation.image.presence %>
        <%= image_tag @organisation.image.variant(:full), class: "organisation__placeholder-image" %>
      <% else %>
        <div class="organisation__placeholder-image"></div>
      <% end %>
    </div>
    <div class="organisation__header-content">
      <h1 class="organisation__title"><%= @organisation.name %></h1>
      <div>
        <span class="workspace__owner-pill">
            <% owner = @organisation.owner %>
            <% if !owner.nil? %>
              <% if owner&.pfp_image.attached? %>
                  <%= image_tag owner.pfp_image, style:"width: 1rem; height: 1rem; border-radius: 50%;"%>
              <% else %>
                  <span class="workspace__owner-pfp-image" aria-hidden="true"><%= owner.username.first&.upcase %></span>
              <% end %>
              <span class="workspace__owner-name"><%= owner.username %></span>
            <% end %>
        </span>
        <p class="organisation__workspace-count"><%= pluralize(@workspaces.count, "workspace") %> &middot; <%= pluralize(@organisation.users.count, "member") %></p>
      </div>
    </div>
  </div>

  <%= render template: @workspace_content || "dashboard/organisations/workspaces/index" %>
</div>
