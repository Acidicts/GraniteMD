<%= stylesheet_link_tag "components/forms" %>

<%= turbo_frame_tag @user do%>

  <%= form_with model: [ :dashboard, @user ] do |form| %>
    <% if @user.errors.any? %>
      <%= alert_box(:error,
                    title: "#{pluralize(@user.errors.count, "error")} prevented this profile from being saved:",
                    dismissible: false) do %>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
    <%= form.text_field :first_name, autofocus: true, placeholder: "First name", class: "field input" %><br>
    <%= form.text_field :last_name, autofocus: true, placeholder: "First name", class: "field input" %><br>
    <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "Email address", class: "field input" %><br>
    <%= form.submit "Save", class: "btn btn-primary" %>
  <% end %>
<% end %>
