<%= form_with(model: workspace) do |form| %>
  <% if workspace.errors.any? %>
    <%= alert_box(:error,
                  title: "#{pluralize(workspace.errors.count, "error")} prohibited this workspace from being saved:",
                  dismissible: false) do %>
      <ul>
        <% workspace.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>
