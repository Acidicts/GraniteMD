<%# File explorer tree for a workspace. Accepts `workspace:` local, falls back to @workspace. %>
<%# Single-root design: the workspace has one root folder; all other %>
<%# folders and files live inside it. %>
<% explorer_workspace = local_assigns[:workspace] || @workspace %>
<% root_folder = explorer_workspace&.folder %>
<% total_pages = explorer_workspace&.pages&.count || 0 %>

<%= turbo_frame_tag "workspace-file-explorer" do %>
<div class="workspace-explorer"
     data-controller="workspace--file-explorer"
     data-action="click@window->workspace--file-explorer#hideContextMenu keydown.esc@window->workspace--file-explorer#hideContextMenu resize@window->workspace--file-explorer#hideContextMenu contextmenu@window->workspace--file-explorer#hideContextMenu">
  <div class="workspace-explorer__header"
       <% if root_folder.present? %>
       data-action="contextmenu->workspace--file-explorer#showContextMenu"
       data-folder-id="<%= root_folder.id %>"
       <% end %>>
    <span class="workspace-explorer__title"><%= explorer_workspace&.name.presence || "Files" %></span>
    <% if root_folder.present? %>
      <button type="button"
              class="workspace-explorer__menu-btn"
              data-action="click->workspace--file-explorer#showMenu"
              data-folder-id="<%= root_folder.id %>"
              title="New file or folder"
              aria-label="New file or folder options"
              aria-haspopup="menu">
        <%= ellipsis_icon(width: 16, height: 16) %>
      </button>
    <% end %>
  </div>

  <% if explorer_workspace.folder.present? %>
    <% if !explorer_workspace.folder.pages.any? && !explorer_workspace.folder.folders.any? %>
    <div class="workspace-explorer__empty">
      <p>No files yet</p>
      <p style="text-align: center; margin: 0.5rem;">Right click or use the ⋯ menu on the header or a folder to create a new folder or file</p>
      <button type="button"
              class="workspace-explorer__new-file btn btn-icon"
              data-action="workspace--file-explorer#showNewFileForm"
              data-folder-id="<%= explorer_workspace.folder.id %>"
              title="New file"
              aria-label="New file">
        <%= new_file_icon(width: 16, height: 16, color:"var(--text)") %>
        <span>New file</span>
      </button>
      <button type="button"
              class="workspace-explorer__new-folder btn btn-icon"
              data-action="workspace--file-explorer#showNewFolderForm"
              data-folder-id="<%= explorer_workspace.folder.id %>"
              title="New folder"
              aria-label="New folder">
        <%= folder_closed_icon(width: 16, height: 16, color:"var(--text)") %>
        <span>New Folder</span>
      </button>
    </div>
    <% end %>
    <ul id="workspace-tree-root" class="workspace-explorer__tree" role="tree" aria-label="Workspace files">
    <%= render partial: "workspace/files/items/folder", collection: explorer_workspace.folder.folders.order(:name), as: :folder, locals: { workspace: explorer_workspace } %>
    <%= render partial: "workspace/files/items/page", collection: explorer_workspace.folder.pages.order(:name), as: :page, locals: { workspace: explorer_workspace } %>
    <%= render partial: "workspace/files/forms/new_folder_form", locals: { workspace: explorer_workspace, folder: explorer_workspace.folder } %>
    <%= render partial: "workspace/files/forms/new_page_form", locals: { workspace: explorer_workspace, folder: explorer_workspace.folder } %>
    </ul>
  <% else %>
    <div class="workspace-explorer__empty">
      <p>No files yet</p>
      <p style="text-align: center; margin: 0.5rem;">Right click or use the ⋯ menu on the header or a folder to create a new folder or file</p>
    </div>
  <% end %>
  <div class="workspace-explorer__context-menu"
       role="menu"
       data-workspace--file-explorer-target="contextMenu"
       hidden>
    <button type="button"
            class="workspace-explorer__folder-new-file"
            data-action="workspace--file-explorer#newFileFromContextMenu"
            title="New file in this folder"
            aria-label="New file in this folder">
      <%= new_file_icon(width: 16, height: 16) %> New File
    </button>
    <button type="button"
            class="workspace-explorer__folder-new-file"
            data-action="workspace--file-explorer#newFolderFromContextMenu"
            title="New folder in this folder"
            aria-label="New folder in this folder">
      <%= folder_closed_icon(width: 16, height: 16) %> New Folder
    </button>
    <button type="button"
            class="workspace-explorer__folder-new-file"
            data-workspace--file-explorer-target="folderRenameButton"
            data-action="workspace--file-explorer#renameFolderFromContextMenu"
            title="Rename this folder"
            aria-label="Rename this folder">
      <%= edit_icon(width: 16, height: 16) %> Rename Folder
    </button>
  </div>
</div>
<% end %>
