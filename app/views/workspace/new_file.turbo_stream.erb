<%# Response to POST /workspace/:workspace_id/pages: reload the whole file %>
<%# explorer via Turbo, load the new page in the editor. %>
<%= turbo_stream.replace "workspace-file-explorer",
      partial: "workspace/file_explorer",
      locals: { workspace: @workspace } %>
<%= turbo_stream.replace "workspace-editor",
      partial: "workspace/editor",
      locals: { page: @page, workspace: @workspace } %>
