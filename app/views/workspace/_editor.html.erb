<%= turbo_frame_tag "workspace-editor" do %>
    <% persisted = page.persisted? %>
    <% save_url = persisted ? save_workspace_page_path(workspace, page) : nil %>
    <%= form_with model: page, url: (save_url || workspace_path(workspace)), method: (persisted ? :patch : :get),
            data: {
            controller: "workspace--editor markdown",
            action: "submit->workspace--editor#handleSubmit",
            "workspace--editor-endpoint-value": save_url,
            "workspace--editor-page-id-value": (page.id if persisted),
            "markdown-pages-value": workspace.page_link_map.to_json,
            "markdown-files-value": workspace.workspace_file_map.to_json,
        },
        class: "workspace--editor__form" do |f| %>
        <div class="workspace-editor__textarea-wrapper__container">
            <div class="workspace-editor__textarea-wrapper__header">
                <% if page.name.nil? %>
                    <p class="workspace-editor__textarea-wrapper__header-text">Select or create a file to start editing</p>
                <% else %>
                    <p class="workspace-editor__textarea-wrapper__header-text"><%= page.name.to_s %><span class="workspace-explorer__page-extention">.md</span></p>
                <% end %>
            </div>
            <div class="workspace-editor__textarea-wrapper">
                <%= f.textarea :body,
                                class: "workspace-editor__textarea",
                                wrap: "off",
                                spellcheck: false,
                                rows: 1,
                                disabled: !persisted,
                                placeholder: (persisted ? "" : ""),
                                data: {
                                "workspace--editor-target": "textarea",
                                "markdown-target": "input",
                                action: "input->workspace--editor#fileChange change->workspace--editor#fileChange input->markdown#update click->markdown#update keydown->markdown#onKeyDown"
                                } %>
                <div class="wikilink-suggest" data-markdown-target="suggestions" role="listbox" hidden></div>
            </div>
        </div>
    <div class="workspace-editor__status" data-workspace--editor-target="status" role="status" aria-live="polite"></div>
    <div class="workspace-editor__preview">
        <button type="button"
                class="toc-toggle"
                data-markdown-target="toggle"
                data-action="click->markdown#toggleToc"
                aria-expanded="false"
                aria-label="Headings in this page"
                title="Headings in this page"
                hidden>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false">
                <path d="M10 3 5 8l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
        <nav class="toc-panel"
             data-markdown-target="toc"
             data-action="keydown->markdown#onTocKeyDown"
             aria-label="Headings in this page"
             hidden>
            <p class="toc-panel__title">On this page</p>
            <div class="toc-wheel"
                 data-markdown-target="wheel"
                 data-action="wheel->markdown#onWheelSpin pointerdown->markdown#onWheelGrab pointermove->markdown#onWheelDrag pointerup->markdown#onWheelRelease pointercancel->markdown#onWheelRelease"
                 role="group"
                 aria-label="Headings wheel. Scroll or drag to turn, click a heading to jump.">
                <div class="toc-wheel__arc" data-markdown-target="arc"></div>
            </div>
        </nav>
        <div class="workspace-editor__preview-body" data-markdown-target="body"></div>
    </div>
  <% end %>
<% end %>
