<%# locals: workspace_file, workspace (optional — falls back to workspace_file.workspace) %>
<% explorer_workspace = local_assigns[:workspace] || workspace_file.workspace %>
<li id="workspace-file-<%= workspace_file.id %>"
    class="workspace-explorer__page-item"
    role="treeitem"
    aria-label="<%= workspace_file.name %>"
    data-page-id="<%= workspace_file.id %>"
    data-extension="<%= File.extname(workspace_file.name.to_s).delete_prefix(".") %>"
    data-action="contextmenu->workspace--file-explorer#showContextMenu">
  <%= link_to workspace_file_path(explorer_workspace, workspace_file),
      class: "workspace-explorer__page-icon-link",
      tabindex: -1,
      aria: { hidden: true },
      data: { turbo_frame: "workspace-editor" } do %>
    <span class="workspace-explorer__page-icon"><%= file_icon(width: 20, height: 20, color: "var(--text)") %></span>
  <% end %>
  <span class="workspace-explorer__page-name-zone">
    <%= link_to workspace_file_path(explorer_workspace, workspace_file),
        class: "workspace-explorer__page",
        data: {
          turbo_frame: "workspace-editor",
          action: "click->workspace--file-explorer#selectPage",
          page_id: workspace_file.id,
          "workspace--file-explorer-target": "page"
        } do %>
      <span class="workspace-explorer__page-name"><%= workspace_file.name.presence || "Untitled" %></span>
    <% end %>
  </span>
  <button type="button"
          class="workspace-explorer__menu-btn"
          data-action="click->workspace--file-explorer#showMenu"
          data-page-id="<%= workspace_file.id %>"
          title="Options for <%= workspace_file.name %>"
          aria-label="Options for <%= workspace_file.name %>"
          aria-haspopup="menu">
    <%= ellipsis_icon(width: 16, height: 16) %>
  </button>
</li>
