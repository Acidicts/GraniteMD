<%# Response to DELETE /workspace/:workspace_id/roadmaps/:id: drop the %>
<%# row and reset the editor to a blank file. %>
<%= turbo_stream.remove "workspace-roadmap-#{@roadmap_id}" %>
<%= turbo_stream.replace "workspace-editor",
      partial: "workspace/editor",
      locals: { page: Page.new, workspace: @workspace } %>
