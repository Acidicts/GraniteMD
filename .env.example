#Site
APP_HOST=https://granitemd.coder.bing-bong.uk/
# Extra hostnames this deployment answers to, in addition to APP_HOST.
# Accepts a JSON array or a comma separated list.
ALLOWED_HOSTS=[ "granitemd.coder.bing-bong.uk", "granite-md.coder.bing-bong.uk" ]

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=production
POSTGRES_URL=postgresql://postgres:password@localhost:5432/production?pool=5

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=xxxxxxxxxxxxxxx
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=xxxxxxxxxxxxxxx
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=xxxxxxxxxxxxxxx

# Email
MAIL_FROM=example@example.com

SMTP_HOST=smtp.purelymail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_DOMAIN=example.com
SMTP_USER=example@example.com
SMTP_PASSWORD=